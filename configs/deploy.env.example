# Source paths; SGLang must be the pinned source, not another installed checkout.
# Optional interpreter override; defaults to .venv-duplex/bin/python in this release.
# export PYTHON=/absolute/path/to/python
export SGLANG_ROOT=/path/to/sglang-v0.5.22
export CODEC_MODEL=/path/to/prepared/duo-distill/codec
export REALIZATION_CHECKPOINT=/path/to/prepared/duo-distill/realization
export INTENT_MODEL=/path/to/prepared/duo-intent-merged
export INTENT_ADAPTER=/path/to/Duo-1.0-causal-base/intent_adapter
export ASR_MODEL=/path/to/Duo-1.0-causal-base/speech/recognizer

# Leave both empty for BF16 DCP inference. Linear and attention are independent.
export REALIZATION_MODELOPT_CHECKPOINT=
export FP8_PROFILE_PATTERN=
export FP8_ATTENTION_LIBRARY=

# Required demo/warmup assets; preparation commands are in docs/deployment.md.
# Sample: frames/*.jpg at 24 FPS, mono PCM16 16 kHz audio.pcm, example.mp4.
# Portraits: seaside/portrait.jpg and dorm/portrait.jpg.
export SAMPLE_ROOT=/path/to/sample
export PORTRAIT_ROOT=/path/to/portraits
export ASR_GPU=3
export ASR_PORT=18084
export BACKEND_PORT=18082
export WEB_PORT=18081
export INTENT_KV_WINDOW_TOKENS=32768
export REALIZATION_KV_WINDOW_TOKENS=65536
# Current block is included; zero retains only the token-budget limit.
export REALIZATION_REFERENCE_WINDOW_CHUNKS=14
export REALIZATION_KV_WORKSPACE_CAPACITY_TOKENS=131072
export WARMUP_BLOCKS=40
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
export TOKENIZERS_PARALLELISM=false
